{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window; may reveal a file in the file manager, open ticketd's GitHub pages and linked GitHub issues, show native save and open dialogs, and follow the Light or Dark choice for the title bar, and send system notifications for due reminders, with no filesystem or shell access.",
  "windows": ["main"],
  "permissions": [
    "opener:allow-reveal-item-in-dir",
    "core:window:allow-set-theme",
    "dialog:allow-save",
    "dialog:allow-open",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "notification:allow-register-listener",
    "notification:allow-remove-listener",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/vantoan19/ticketd" },
        { "url": "https://github.com/vantoan19/ticketd#*" },
        { "url": "https://github.com/vantoan19/ticketd/*" },
        { "url": "https://github.com/*/*/issues/*" }
      ]
    }
  ]
}
