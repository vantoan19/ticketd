{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window; may reveal a file in the file manager, open ticketd's GitHub pages, show native save and open dialogs, and send system notifications for due reminders, with no filesystem or shell access.",
  "windows": ["main"],
  "permissions": [
    "opener:allow-reveal-item-in-dir",
    "dialog:allow-save",
    "dialog:allow-open",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/vantoan19/ticketd" },
        { "url": "https://github.com/vantoan19/ticketd#*" },
        { "url": "https://github.com/vantoan19/ticketd/*" }
      ]
    }
  ]
}
