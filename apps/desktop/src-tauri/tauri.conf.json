{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ticketd",
  "version": "0.1.0",
  "identifier": "com.vantoan19.ticketd",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:executable --workspace @ticketd/chat-bridge-claude && npm run build --workspace @ticketd/desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ticketd",
        "width": 1280,
        "height": 772,
        "minWidth": 480,
        "minHeight": 600,
        "titleBarStyle": "Transparent",
        "zoomHotkeysEnabled": false,
        "hiddenTitle": true,
        "backgroundColor": "#FAFAFA",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: attachment-media: http://attachment-media.localhost; media-src attachment-media: http://attachment-media.localhost; object-src 'none'; frame-src 'none'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "externalBin": ["../../chat-bridge-claude/dist/ticketd-chat-bridge-claude"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": {
        "installerArgs": ["REBOOT=ReallySuppress"]
      },
      "endpoints": [
        "https://github.com/vantoan19/ticketd/releases/latest/download/latest.json"
      ]
    }
  }
}
