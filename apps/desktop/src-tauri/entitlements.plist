<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The Claude chat bridge is a Bun executable. Signed with the hardened
       runtime, its JavaScript engine needs JIT memory; without it the bridge
       crashes at its first command ("SharedArrayBuffer is not defined"). -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
