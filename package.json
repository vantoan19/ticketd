{
  "name": "ticketd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "apps/docs"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "npm run dev --workspace @ticketd/desktop",
    "desktop": "npm run tauri --workspace @ticketd/desktop --",
    "build": "npm run build --workspace @ticketd/desktop",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "check": "./scripts/check",
    "docs": "npm run dev --workspace @ticketd/docs",
    "build:docs": "npm run build --workspace @ticketd/docs"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@shadcn/lint": "0.2.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16",
    "markdownlint-cli2": "0.24.0",
    "prettier": "^3",
    "typescript-eslint": "^8",
    "webdriverio": "10.1.0"
  },
  "overrides": {
    "re2js": "^2.9.1"
  }
}
