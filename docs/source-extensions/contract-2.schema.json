            "desktop_instruction": null,
            "terminal_hint": null
          }
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetPresentation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      }
    },
