      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/ErrorClass"
        },
        "code": {
          "description": "The failure code of the part (`not_found` or `forbidden`).",
          "type": "string"
        },
        "field": {
          "description": "The setting that named the part, so a preview can point at it.",
          "type": [
            "string",
            "null"
          ],
          "default": null
