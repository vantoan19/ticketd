            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "show_if": {
          "description": "An input key that must have a value for this setting to apply.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "oneOf": [
        {
          "description": "One line of text. An empty value means the field is not set.",
          "type": "object",
          "properties": {
            "format": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ValueFormat"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "An ordered set of values picked from options and, when allowed, typed.",
          "type": "object",
          "properties": {
            "allow_custom": {
              "description": "Whether a value that is not among the offered options is accepted.",
              "type": "boolean",
              "default": false
            },
            "format": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ValueFormat"
                },
                {
                  "type": "null"
                }
              ]
            },
            "max_items": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "min_items": {
              "type": "integer",
              "format": "uint",
              "default": 0,
              "minimum": 0
            },
