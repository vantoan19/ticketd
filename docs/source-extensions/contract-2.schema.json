{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract2",
  "anyOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Response"
    },
    {
      "$ref": "#/$defs/ProgressNotification"
    },
    {
      "$ref": "#/$defs/CancelNotification"
    }
  ],
  "$defs": {
    "CancelMethod": {
      "type": "string",
      "enum": [
        "cancel"
      ]
    },
    "CancelNotification": {
      "description": "Stop the request identified by params.id and send its terminal error response.",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpc"
        },
        "method": {
          "$ref": "#/$defs/CancelMethod"
        },
        "params": {
          "$ref": "#/$defs/CancelParams"
        }
      },
      "required": [
        "jsonrpc",
        "method",
        "params"
      ]
    },
    "CancelParams": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "id"
      ]
    },
    "ChoiceOption": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ]
    },
    "ConfigSchema": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SchemaField"
          }
        }
      },
      "required": [
        "fields"
      ]
    },
    "ConnectionCheck": {
      "description": "The verified connection and answers derived from its settings.",
      "type": "object",
      "properties": {
        "connection": {
          "$ref": "#/$defs/ConnectionInfo"
        },
        "derived": {
          "$ref": "#/$defs/DerivedConfiguration"
        }
      },
      "required": [
        "connection",
        "derived"
      ]
    },
    "ConnectionInfo": {
      "description": "The account the connector is acting as. Never contains a credential.",
      "type": "object",
      "properties": {
        "account": {
          "description": "The label shown for the signed-in account.",
          "type": "string"
        },
        "account_id": {
          "description": "Stable account identity on this site when the display label is not an identity.",
          "type": [
            "string",
            "null"
          ]
        },
        "publication_requires_tracker_time": {
          "description": "Whether this source needs tracker time evidence before ticketd can safely publish.",
          "type": "boolean"
        },
        "site": {
          "description": "Canonical site identity. Empty when the provider has only one site.",
          "type": "string",
          "default": ""
        },
        "tracker_time": {
          "description": "RFC 3339 time reported by the tracker during this authenticated check, when available.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "account"
      ]
    },
    "ConnectionParams": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": true
        },
        "connection_id": {
          "type": "string"
        }
      },
      "required": [
        "connection_id",
        "config"
      ]
    },
    "Conversation": {
      "description": "An issue's whole conversation. Order is not significant; the engine sorts\nit chronologically.",
      "type": "object",
      "properties": {
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExternalComment"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExternalEvent"
          }
        }
      },
      "required": [
        "comments",
        "events"
      ]
    },
    "DerivedConfiguration": {
      "description": "Configuration answers that ticketd can keep for use without a connector call.",
      "type": "object",
      "properties": {
        "discovery_scope": {
          "description": "A stable key for filters that narrow what discovery reads within each part.\nAn empty key means discovery does not narrow the part.",
          "type": "string"
        },
        "partitions": {
          "description": "Parts read by discovery, named as in [`ExternalRef::partition`].",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publication": {
          "$ref": "#/$defs/DestinationRules"
        }
      },
      "required": [
        "partitions",
        "discovery_scope",
        "publication"
      ]
    },
    "Description": {
      "type": "object",
      "properties": {
        "contract_version": {
          "description": "Null when the extension does not support any versions offered by the host.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "contract_versions": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceDescription"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "contract_versions",
        "version"
      ]
    },
    "DestinationRules": {
      "description": "Destination choices and the rules for checking a destination locally.",
      "type": "object",
      "properties": {
        "case_insensitive": {
          "description": "Whether destination matching ignores ASCII case.",
          "type": "boolean"
        },
        "destination_labels": {
          "description": "Optional display labels keyed by canonical destination.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "destinations": {
          "description": "Accepted destinations in their canonical spelling. Empty when the\nconnector cannot enumerate them.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation": {
          "anyOf": [
            {
              "$ref": "#/$defs/DestinationValidation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "destinations",
        "case_insensitive"
      ]
    },
    "DestinationValidation": {
      "type": "object",
      "properties": {
        "format": {
          "$ref": "#/$defs/ValueFormat"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "format",
        "message"
      ]
    },
    "DiscoveryPage": {
      "type": "object",
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExternalIssue"
          }
        },
        "next_cursor": {
          "description": "`Some` while more results remain. A page may be empty and still have a\ncontinuation, so an empty page is never proof that discovery is done.",
          "type": [
            "string",
            "null"
          ]
        },
        "skipped": {
          "description": "Parts of the discovery rules the connector could not read (a repository\nthat is gone or inaccessible) and skipped, so the rest still ran.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkippedPartition"
          }
        }
      },
      "required": [
        "issues",
        "skipped"
      ]
    },
    "ErrorClass": {
      "description": "A broad cause that a caller can handle without knowing every failure code.",
      "type": "string",
      "enum": [
        "config",
        "auth",
        "transient",
        "system"
      ]
    },
    "ExternalComment": {
      "description": "A comment on an external issue, as its source reports it. Authors are the\nsource's own identities, never ticketd editing agents.",
      "type": "object",
      "properties": {
        "author": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "id": {
          "description": "Stable within the issue; repeated reads of one comment return one id.",
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "url": {
          "description": "Where the comment can be viewed at the source.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "author",
        "body",
        "url",
        "created_at",
        "updated_at"
      ]
    },
    "ExternalEvent": {
      "description": "A timeline event such as a closure, reopening or assignment change.",
      "type": "object",
      "properties": {
        "actor": {
          "description": "Who acted, when the source says.",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ExternalEventKind"
        },
        "subject": {
          "description": "The assignee, destination workflow state, or related issue when known.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "created_at"
      ]
    },
    "ExternalEventKind": {
      "description": "What happened in an external timeline event.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "category": {
              "$ref": "#/$defs/StateCategory"
            },
            "event": {
              "type": "string",
              "const": "closed"
            }
          },
          "required": [
            "event",
            "category"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "reopened"
            }
          },
          "required": [
            "event"
          ]
        },
        {
          "description": "A workflow change that does not itself establish a closure or reopening.",
          "type": "object",
          "properties": {
            "category": {
              "$ref": "#/$defs/StateCategory"
            },
            "event": {
              "type": "string",
              "const": "state_changed"
            }
          },
          "required": [
            "event",
            "category"
          ]
        },
        {
          "description": "This issue was marked as a duplicate of another issue.",
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "marked_duplicate"
            }
          },
          "required": [
            "event"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "unmarked_duplicate"
            }
          },
          "required": [
            "event"
          ]
        },
        {
          "description": "Another issue was marked as a duplicate of this issue.",
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "duplicate_added"
            }
          },
          "required": [
            "event"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "duplicate_removed"
            }
          },
          "required": [
            "event"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "assigned"
            }
          },
          "required": [
            "event"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "unassigned"
            }
          },
          "required": [
            "event"
          ]
        }
      ]
    },
    "ExternalIdentity": {
      "description": "An external issue's immutable identity. Titles, numbers and repository\nnames can change; this cannot. Never match issues by display text.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "id"
      ]
    },
    "ExternalIssue": {
      "description": "An issue as the provider reports it, in provider-neutral form.",
      "type": "object",
      "properties": {
        "assignees": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "author": {
          "description": "The source identity that opened the issue, when known.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "body": {
          "type": "string"
        },
        "created_at": {
          "description": "When the issue was opened at the source, as an RFC 3339 timestamp.",
          "type": "string"
        },
        "display": {
          "description": "Human-readable name such as `owner/name#12`. Display only.",
          "type": "string"
        },
        "duplicate_of": {
          "description": "For an issue closed as a duplicate: the canonical issue, when the provider\nnames an accessible one. Absent means the target is unknown.",
          "anyOf": [
            {
              "$ref": "#/$defs/ExternalRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "duplicate_of_url": {
          "description": "Where the canonical issue can be opened, when the provider says.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "duplicate_withdrawn": {
          "description": "The provider says the duplicate marking was withdrawn. Distinct from\n`duplicate_of` being `None`, which only means no target was supplied (a\nlookup failed or access changed) and keeps the last known one.",
          "type": "boolean",
          "default": false
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference": {
          "$ref": "#/$defs/ExternalRef"
        },
        "state": {
          "$ref": "#/$defs/ExternalState"
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "description": "When the issue was last updated at the source, as an RFC 3339 timestamp.",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "reference",
        "display",
        "url",
        "title",
        "body",
        "state",
        "assignees",
        "labels",
        "created_at",
        "updated_at"
      ]
    },
    "ExternalRef": {
      "description": "Enough to ask the connector for an issue again. `locator` is opaque to\nticketd and defined by the connector (for GitHub, `owner/name#number`).",
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/ExternalIdentity"
        },
        "locator": {
          "type": "string"
        },
        "partition": {
          "description": "The part of discovery this issue belongs to, such as a repository.\nAn empty string denotes a source that is read as one whole.",
          "type": "string"
        }
      },
      "required": [
        "identity",
        "locator",
        "partition"
      ]
    },
    "ExternalState": {
      "type": "object",
      "properties": {
        "category": {
          "$ref": "#/$defs/StateCategory"
        },
        "name": {
          "description": "The tracker's own name for the state, used only for display. Older\nobservations may have no name.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "category"
      ]
    },
    "Failure": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/RpcError"
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpc"
        }
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "error"
      ]
    },
    "FieldIssue": {
      "type": "object",
      "properties": {
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "message"
      ]
    },
    "FieldPattern": {
      "description": "A regular expression and instructions for correcting a mismatched value.",
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "regex": {
          "type": "string"
        }
      },
      "required": [
        "regex",
        "message"
      ]
    },
    "FieldPresentation": {
      "type": "object",
      "properties": {
        "additional_placeholder": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "placeholder": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "IssueName": {
      "description": "The last occurrence of the separator ends the place. The separator is\nincluded in the displayed number when it is part of the issue's name.",
      "type": "object",
      "properties": {
        "place_separator": {
          "description": "A place separator to surround with spaces in the human-readable label.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "separator": {
          "type": "string",
          "default": ""
        },
        "separator_in_number": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "IssueParams": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": true
        },
        "connection_id": {
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/ExternalRef"
        }
      },
      "required": [
        "connection_id",
        "config",
        "reference"
      ]
    },
    "JsonRpc": {
      "type": "string",
      "enum": [
        "2.0"
      ]
    },
    "OptionSource": {
      "description": "Where a selector gets its options.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "options": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ChoiceOption"
              }
            },
            "source": {
              "type": "string",
              "const": "static"
            }
          },
          "required": [
            "source",
            "options"
          ]
        },
        {
          "description": "Options come from the connector while the person types. `depends_on`\nnames fields whose current values the connector needs.",
          "type": "object",
          "properties": {
            "depends_on": {
              "type": "array",
              "default": [],
              "items": {
                "type": "string"
              }
            },
            "source": {
              "type": "string",
              "const": "dynamic"
            }
          },
          "required": [
            "source"
          ]
        }
      ]
    },
    "ProgressMethod": {
      "type": "string",
      "enum": [
        "progress"
      ]
    },
    "ProgressNotification": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpc"
        },
        "method": {
          "$ref": "#/$defs/ProgressMethod"
        },
        "params": {
          "$ref": "#/$defs/ProgressParams"
        }
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "method",
        "params"
      ]
    },
    "ProgressParams": {
      "type": "object",
      "properties": {
        "completed": {
          "description": "Number of items processed in this request so far.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "description": "ID of the active request, carried in params because this is a notification.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total": {
          "description": "Total number of items when known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "completed"
      ]
    },
    "PublicationCandidates": {
      "description": "What a search found. `matches` holds every issue the connector saw whose\ntitle or non-empty description equals what the attempt sent. `recent` holds\nother issues the connected account created in the window, including issues\nthat may have been edited since publication. `complete` describes search\ncoverage. It is true only when the connector covered every possible result\nof the attempt. Either populated list or incomplete coverage keeps a\n\"not created\" resolution unavailable.",
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExternalIssue"
          }
        },
        "recent": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ExternalIssue"
          }
        }
      },
      "required": [
        "matches",
        "complete"
      ]
    },
    "PublicationSearch": {
      "description": "A search for issues an earlier, uncertain publish may have created.",
      "type": "object",
      "properties": {
        "account": {
          "description": "The account ID, or its label when the source has no separate ID. Whatever it created in\nthe window is a candidate, whatever its text now says: a teammate or an\nautomation may have edited the title and description since.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "request": {
          "description": "Exactly what the earlier attempt sent.",
          "$ref": "#/$defs/PublishRequest"
        },
        "since": {
          "description": "The lower bound based on the device clock, in RFC 3339.",
          "type": "string"
        },
        "tracker_since": {
          "description": "The lower bound based on the tracker clock immediately before the mutation, when known.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "request",
        "since"
      ]
    },
    "PublishRequest": {
      "description": "A request to create an ordinary issue. Connectors that do not declare\n[`Capability::Publish`] keep the default implementation. It carries exactly\nwhat the person previewed: no ticketd metadata, labels or comments.",
      "type": "object",
      "properties": {
        "body": {
          "type": "string"
        },
        "destination": {
          "description": "Connector-defined destination, such as `owner/name`.",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "body",
        "destination"
      ]
    },
    "PullRequestLink": {
      "description": "How to recognize an evidence link with the path /owner/project/segment/number.",
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "segment": {
          "type": "string"
        }
      },
      "required": [
        "host",
        "segment"
      ]
    },
    "Request": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpc"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "describe"
            },
            "params": {
              "type": "object",
              "properties": {
                "contract_versions": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  }
                },
                "pid": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "required": [
                "contract_versions",
                "pid"
              ]
            }
          },
          "required": [
            "method",
            "params"
          ]
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
