      "description": "How a source state affects ticketd's workflow. Connectors derive the\ncategory from typed provider data and use Unknown for an unrecognized value.",
      "type": "string",
      "enum": [
        "open",
        "completed",
        "not_planned",
        "duplicate",
        "unknown"
      ]
    },
