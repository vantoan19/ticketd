    "TargetPresentation": {
      "type": "object",
      "properties": {
        "add": {
          "type": "string"
        },
        "choose": {
          "type": "string"
        },
        "example": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "field",
        "label",
        "example",
        "choose",
        "add"
      ]
    },
    "ValueFormat": {
      "description": "Built-in syntax checks a field can ask for.",
      "oneOf": [
        {
          "description": "`owner/name`, as in a repository path.",
          "type": "string",
          "const": "owner_name"
        },
        {
          "description": "A short account handle: letters, digits and single hyphens.",
          "type": "string",
          "const": "handle"
        },
        {
          "description": "A label or similar tag: no commas or line breaks, at most 50 characters.",
          "type": "string",
          "const": "label"
        }
      ]
    },
    "WireFailure": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/ErrorClass"
        },
        "code": {
          "$ref": "#/$defs/WireFailureCode"
        },
        "detail": {
          "description": "A fixed diagnostic code. Use up to 80 lower-case ASCII letters, digits,\nunderscores or hyphens. ticketd accepts this field and does not log it.",
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FieldIssue"
          }
        },
        "message": {
          "type": "string"
        },
        "retry_after_secs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "class",
        "code",
        "message"
      ]
    },
    "WireFailureCode": {
      "type": "string",
      "enum": [
        "unauthenticated",
        "forbidden",
        "not_found",
        "rate_limited",
        "unavailable",
        "not_sent",
        "rejected",
        "protocol",
        "unsupported",
        "invalid_configuration"
      ]
    }
  }
