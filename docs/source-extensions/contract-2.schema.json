      "description": "The schema and presentation for a source registered with the engine.",
      "type": "object",
      "properties": {
        "capabilities": {
          "description": "Known names describe the supported operations. A host ignores names for\nfuture optional capabilities that it does not yet recognize.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contract_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "presentation": {
          "$ref": "#/$defs/SourcePresentation"
        },
        "provider": {
          "description": "Stable provider id, such as `github`. It is part of every external identity.",
          "type": "string"
        },
        "schema": {
          "$ref": "#/$defs/ConfigSchema"
        }
      },
      "required": [
        "provider",
        "name",
        "contract_version",
        "capabilities",
        "schema",
        "presentation"
      ]
    },
